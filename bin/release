#!/usr/bin/env bash
set -euo pipefail

HOMEBREW_TAP_REPO="futuremill/homebrew-squirrelstack"
CLI_REPO="futuremill/squirrelstack-cli"

# Extract version from the script
VERSION=$(grep '^VERSION=' squirrelstack | head -1 | sed 's/VERSION="//' | sed 's/"//')

if [[ -z "$VERSION" ]]; then
  echo "Error: Could not extract VERSION from squirrelstack script" >&2
  exit 1
fi

TAG="v${VERSION}"

echo "Releasing squirrelstack ${TAG}..."
echo ""

# Check we're on main and clean
if [[ "$(git branch --show-current)" != "main" ]]; then
  echo "Error: Must be on main branch" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Error: Working directory is not clean. Commit or stash changes first." >&2
  exit 1
fi

# Check tag doesn't already exist
if git rev-parse "$TAG" >/dev/null 2>&1; then
  echo "Error: Tag ${TAG} already exists. Bump VERSION in squirrelstack first." >&2
  exit 1
fi

# Push latest
echo "Pushing to origin..."
git push origin main

# Tag and push tag
echo "Creating tag ${TAG}..."
git tag "$TAG"
git push origin "$TAG"

# Create GitHub release
echo "Creating GitHub release..."
gh release create "$TAG" --repo "$CLI_REPO" --title "$TAG" --notes "Release ${TAG}"

# Get tarball SHA
echo "Computing tarball SHA256..."
SHA=$(curl -sL "https://github.com/${CLI_REPO}/archive/refs/tags/${TAG}.tar.gz" | shasum -a 256 | awk '{print $1}')
echo "  SHA256: ${SHA}"

# Update Homebrew formula
echo "Updating Homebrew formula..."

FORMULA_DIR=$(mktemp -d)
gh repo clone "$HOMEBREW_TAP_REPO" "$FORMULA_DIR" -- -q 2>/dev/null

cat > "${FORMULA_DIR}/Formula/squirrelstack.rb" <<FORMULA
class Squirrelstack < Formula
  desc "CLI for SquirrelStack error management"
  homepage "https://github.com/${CLI_REPO}"
  url "https://github.com/${CLI_REPO}/archive/refs/tags/${TAG}.tar.gz"
  sha256 "${SHA}"
  license :cannot_represent

  def install
    bin.install "squirrelstack"
  end

  test do
    assert_match "squirrelstack ${VERSION}", shell_output("#{bin}/squirrelstack version")
  end
end
FORMULA

cd "$FORMULA_DIR"
git add Formula/squirrelstack.rb
git commit -m "Update squirrelstack to ${TAG}"
git push origin main
cd -

rm -rf "$FORMULA_DIR"

echo ""
echo "Released squirrelstack ${TAG}"
echo "  GitHub: https://github.com/${CLI_REPO}/releases/tag/${TAG}"
echo "  Homebrew: brew upgrade squirrelstack"
