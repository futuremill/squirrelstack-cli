# Parses the shared epic options into JSON triples. Sets EPIC_FIELDS.
parse_epic_options() {
  EPIC_FIELDS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)       EPIC_FIELDS+=(title s "$2"); shift 2 ;;
      --description) EPIC_FIELDS+=(description s "$2"); shift 2 ;;
      --bucket)      EPIC_FIELDS+=(priority_bucket s "$2"); shift 2 ;;
      --theme)       EPIC_FIELDS+=(theme s "$2"); shift 2 ;;
      --owner)
        if [[ "$2" == "none" ]]; then EPIC_FIELDS+=(owner_id null ""); else EPIC_FIELDS+=(owner_id n "$2"); fi
        shift 2 ;;
      --start)       EPIC_FIELDS+=(start_date s "$2"); shift 2 ;;
      --end)         EPIC_FIELDS+=(end_date s "$2"); shift 2 ;;
      --position)    EPIC_FIELDS+=(position n "$2"); shift 2 ;;
      *)             die "Unknown option: $1" ;;
    esac
  done
}

