#!/usr/bin/env bash
set -euo pipefail

VERSION="0.5.0"
KEYCHAIN_SERVICE="squirrelstack-cli"
LEGACY_KEYCHAIN_ACCOUNT="pat"   # pre-0.4 single-token storage; migrated on first use
BASE_URL="${SQUIRRELSTACK_URL:-https://squirrelstack.app}"
CLIENT_NAME="SquirrelStack CLI"

# Index of logged-in users (one email per line). Not secret — tokens live in Keychain.
USERS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/squirrelstack"
USERS_INDEX="$USERS_DIR/users"

# Account resolution. Populated by resolve_account(); used by api_request.
ACCOUNT_SLUG=""
ACCOUNT_SOURCE=""
ACCOUNT_FLAG=""

# User resolution. Populated by resolve_user(); selects which Keychain token to use.
USER_EMAIL=""
USER_SOURCE=""
USER_FLAG=""

# Set by register_token() to the email it stored a token for.
REGISTERED_USER=""

urlencode() { ruby -ruri -e 'print URI.encode_www_form_component(ARGV[0])' -- "$1"; }

# --- Helpers ---

die() { echo "Error: $1" >&2; exit 1; }

# Keychain entries are keyed by the user's email (account = email). The pre-0.4
# single-token entry used the constant LEGACY_KEYCHAIN_ACCOUNT; it's migrated away.
keychain_get_for() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" -w 2>/dev/null || echo ""
}

keychain_set_for() {
  local account="$1" token="$2"
  security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$account" 2>/dev/null || true
  security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$account" -w "$token"
}

keychain_delete_for() {
  security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" 2>/dev/null || true
}

# --- User index (logged-in emails; not secret — tokens live in Keychain) ---

users_index_list() {
  [[ -f "$USERS_INDEX" ]] && grep -v '^[[:space:]]*$' "$USERS_INDEX" || true
}

users_index_add() {
  mkdir -p "$USERS_DIR"
  touch "$USERS_INDEX"
  grep -qxF "$1" "$USERS_INDEX" || echo "$1" >> "$USERS_INDEX"
}

users_index_remove() {
  [[ -f "$USERS_INDEX" ]] || return 0
  grep -vxF "$1" "$USERS_INDEX" > "$USERS_INDEX.tmp" 2>/dev/null || true
  mv "$USERS_INDEX.tmp" "$USERS_INDEX"
  [[ -s "$USERS_INDEX" ]] || rm -f "$USERS_INDEX"
}

users_index_count() {
  local n
  n=$(users_index_list | grep -c . || true)
  echo "${n:-0}"
}

multi_user_error() {
  {
    echo "Error: multiple users are logged in — pick one."
    echo "  squirrelstack --user <email> ..."
    echo "  squirrelstack users use <email>"
    echo "  export SQUIRRELSTACK_USER=<email>"
    echo "Logged in: $(users_index_list | paste -sd ', ' -)"
  } >&2
  exit 1
}

# Verifies a token against /api/v1/me, then stores it keyed by the user's email
# and adds the email to the index. Sets REGISTERED_USER. Dies on a bad token.
register_token() {
  local token="$1" me email
  me=$(curl -sS -H "Authorization: Bearer $token" "${BASE_URL}/api/v1/me") \
    || die "Could not verify token (request to /api/v1/me failed)."
  email=$(printf '%s' "$me" | ruby -rjson -e '
    data = JSON.parse(STDIN.read) rescue {}
    email = data["email"] || (data["user"] && data["user"]["email"]) || data["user_email"]
    if email.nil? || email.to_s.strip.empty?
      $stderr.puts "Could not determine your email from /api/v1/me (token may be invalid)."
      exit 1
    end
    puts email
  ') || die "Token verification failed."
  keychain_set_for "$email" "$token"
  users_index_add "$email"
  REGISTERED_USER="$email"
}

# Pre-0.4 stored a single token under LEGACY_KEYCHAIN_ACCOUNT. If the index is
# empty but that token exists, adopt it into email-keyed storage. Best-effort:
# if /me is unreachable (offline) the legacy entry is left in place for fallback.
migrate_legacy_token() {
  [[ "$(users_index_count)" == "0" ]] || return 0
  local legacy
  legacy=$(keychain_get_for "$LEGACY_KEYCHAIN_ACCOUNT")
  [[ -n "$legacy" ]] || return 0
  echo "Migrating your saved login to multi-user storage..." >&2
  if register_token "$legacy" 2>/dev/null; then
    keychain_delete_for "$LEGACY_KEYCHAIN_ACCOUNT"
    echo "Migrated as $REGISTERED_USER." >&2
  fi
}

first_run_setup() {
  echo "No token found. Let's set one up."
  echo ""
  echo "You can either:"
  echo "  1. Log in via your browser (recommended)"
  echo "  2. Paste an existing PAT"
  echo ""
  read -rp "Choose [1/2]: " choice

  case "$choice" in
    1) cmd_login ;;
    2)
      read -rsp "Paste your PAT (pat_...): " token
      echo ""
      [[ "$token" == pat_* ]] || die "Token must start with pat_"
      register_token "$token"
      echo "Token saved for $REGISTERED_USER."
      ;;
    *) die "Invalid choice." ;;
  esac
}

load_token() {
  if [[ -n "${SQUIRRELSTACK_TOKEN:-}" ]]; then
    TOKEN="$SQUIRRELSTACK_TOKEN"
    return
  fi

  migrate_legacy_token
  resolve_user

  # A user resolved (via flag/env/config/single default) — use their token.
  if [[ -n "$USER_EMAIL" ]]; then
    TOKEN=$(keychain_get_for "$USER_EMAIL")
    [[ -n "$TOKEN" ]] || die "No saved token for '$USER_EMAIL' (selected via $USER_SOURCE). Run: squirrelstack login"
    return
  fi

  # No user resolved but several are logged in — make them choose.
  [[ "$(users_index_count)" -le 1 ]] || multi_user_error

  # Offline-migration fallback: legacy token still present, index empty.
  local legacy
  legacy=$(keychain_get_for "$LEGACY_KEYCHAIN_ACCOUNT")
  if [[ -n "$legacy" ]]; then
    TOKEN="$legacy"
    return
  fi

  # Nothing stored at all — first-run interactive setup.
  first_run_setup
  resolve_user
  TOKEN=$(keychain_get_for "$USER_EMAIL")
  [[ -n "$TOKEN" ]] || die "Token setup failed."
}

# Reads the `account=` line from a `.squirrelstack` file. Returns empty on miss.
read_account_from_file() {
  read_config_key "$1" account
}

# Reads the `user=` line from a `.squirrelstack` file. Returns empty on miss.
read_user_from_file() {
  read_config_key "$1" user
}

# Reads a `key=value` line from a config file. Returns empty on miss.
# The trailing `|| true` matters: under `set -o pipefail`, a non-matching grep
# fails the whole pipeline, which would trip `set -e` at the calling assignment.
read_config_key() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || { echo ""; return; }
  grep -E "^${key}[[:space:]]*=" "$file" 2>/dev/null \
    | head -1 \
    | sed -E "s/^${key}[[:space:]]*=[[:space:]]*//" \
    | tr -d '[:space:]' || true
}

# Upserts `key=value` in a config file, preserving other lines. Creates the file
# if needed. account= and user= share the same .squirrelstack file, so writes
# must not clobber the other key.
set_config_key() {
  local file="$1" key="$2" value="$3"
  if [[ -f "$file" ]]; then
    grep -vE "^${key}[[:space:]]*=" "$file" > "$file.tmp" 2>/dev/null || true
    mv "$file.tmp" "$file"
  fi
  echo "${key}=${value}" >> "$file"
}

# Removes a `key=` line from a config file, deleting the file if it ends up empty.
clear_config_key() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  grep -vE "^${key}[[:space:]]*=" "$file" > "$file.tmp" 2>/dev/null || true
  mv "$file.tmp" "$file"
  [[ -s "$file" ]] || rm -f "$file"
}

# Resolution order (mirrors resolve_account, one level up — a user owns accounts):
#   1. --user flag
#   2. SQUIRRELSTACK_USER env
#   3. .squirrelstack walked up from cwd (stops at $HOME or /)
#   4. ~/.squirrelstack
#   5. The only logged-in user, if there's exactly one
resolve_user() {
  if [[ -n "$USER_FLAG" ]]; then
    USER_EMAIL="$USER_FLAG"
    USER_SOURCE="--user flag"
    return
  fi

  if [[ -n "${SQUIRRELSTACK_USER:-}" ]]; then
    USER_EMAIL="$SQUIRRELSTACK_USER"
    USER_SOURCE="SQUIRRELSTACK_USER env var"
    return
  fi

  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    local found
    found=$(read_user_from_file "$dir/.squirrelstack")
    if [[ -n "$found" ]]; then
      USER_EMAIL="$found"
      USER_SOURCE="$dir/.squirrelstack"
      return
    fi
    [[ "$dir" == "$HOME" ]] && break
    dir=$(dirname "$dir")
  done

  local home_value
  home_value=$(read_user_from_file "$HOME/.squirrelstack")
  if [[ -n "$home_value" ]]; then
    USER_EMAIL="$home_value"
    USER_SOURCE="$HOME/.squirrelstack"
    return
  fi

  if [[ "$(users_index_count)" == "1" ]]; then
    USER_EMAIL="$(users_index_list)"
    USER_SOURCE="only logged-in user"
    return
  fi

  USER_EMAIL=""
  USER_SOURCE=""
}

# Resolution order:
#   1. --account flag
#   2. SQUIRRELSTACK_ACCOUNT env
#   3. .squirrelstack walked up from cwd (stops at $HOME or /)
#   4. ~/.squirrelstack
#   5. Server default (only works when user has exactly one account)
resolve_account() {
  if [[ -n "$ACCOUNT_FLAG" ]]; then
    ACCOUNT_SLUG="$ACCOUNT_FLAG"
    ACCOUNT_SOURCE="--account flag"
    return
  fi

  if [[ -n "${SQUIRRELSTACK_ACCOUNT:-}" ]]; then
    ACCOUNT_SLUG="$SQUIRRELSTACK_ACCOUNT"
    ACCOUNT_SOURCE="SQUIRRELSTACK_ACCOUNT env var"
    return
  fi

  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    local found
    found=$(read_account_from_file "$dir/.squirrelstack")
    if [[ -n "$found" ]]; then
      ACCOUNT_SLUG="$found"
      ACCOUNT_SOURCE="$dir/.squirrelstack"
      return
    fi
    [[ "$dir" == "$HOME" ]] && break
    dir=$(dirname "$dir")
  done

  local home_value
  home_value=$(read_account_from_file "$HOME/.squirrelstack")
  if [[ -n "$home_value" ]]; then
    ACCOUNT_SLUG="$home_value"
    ACCOUNT_SOURCE="$HOME/.squirrelstack"
    return
  fi

  ACCOUNT_SLUG=""
  ACCOUNT_SOURCE="server default"
}

# Sends an HTTP request. Includes X-Account-Slug when resolved.
api_request() {
  local method="$1"
  local path="$2"
  shift 2
  local url="${BASE_URL}/api/v1${path}"

  local -a headers=( -H "Authorization: Bearer $TOKEN" )
  if [[ -n "$ACCOUNT_SLUG" ]]; then
    headers+=( -H "X-Account-Slug: $ACCOUNT_SLUG" )
  fi

  local response
  response=$(curl -sS -w "\n%{http_code}" -X "$method" "${headers[@]}" "$url" "$@" 2>&1) || die "Request failed: $response"

  local http_code body
  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$http_code" == "401" ]]; then
    if [[ -z "${SQUIRRELSTACK_TOKEN:-}" ]]; then
      echo "Token is invalid or expired. Removing from Keychain." >&2
      if [[ -n "$USER_EMAIL" ]]; then
        keychain_delete_for "$USER_EMAIL"
        users_index_remove "$USER_EMAIL"
      else
        keychain_delete_for "$LEGACY_KEYCHAIN_ACCOUNT"
      fi
    else
      echo "Token (SQUIRRELSTACK_TOKEN) is invalid or expired." >&2
    fi
    die "Please run 'squirrelstack login' to re-authenticate."
  fi

  if [[ "$http_code" == "400" ]] && echo "$body" | grep -q "Account required"; then
    local available
    available=$(echo "$body" | ruby -rjson -e 'puts (JSON.parse(STDIN.read)["available_accounts"] || []).join(", ")' 2>/dev/null || echo "")
    {
      echo "Error: account required."
      echo "Your user belongs to multiple accounts. Pick one with:"
      echo "  squirrelstack --account <slug> ..."
      echo "  squirrelstack accounts use <slug>"
      echo "  export SQUIRRELSTACK_ACCOUNT=<slug>"
      [[ -n "$available" ]] && echo "Available accounts: $available"
    } >&2
    exit 1
  fi

  if [[ "$http_code" == "403" ]] && echo "$body" | grep -q "inaccessible account"; then
    local available
    available=$(echo "$body" | ruby -rjson -e 'puts (JSON.parse(STDIN.read)["available_accounts"] || []).join(", ")' 2>/dev/null || echo "")
    {
      echo "Error: account '$ACCOUNT_SLUG' is not one of your accounts."
      [[ -n "$available" ]] && echo "Available accounts: $available"
      echo "(account selected via $ACCOUNT_SOURCE)"
    } >&2
    exit 1
  fi

  if [[ "$http_code" -ge 400 ]]; then
    die "API returned $http_code: $body"
  fi

  echo "$body"
}

api_get() { api_request GET "$@"; }

api_patch() {
  local path="$1"
  shift
  api_request PATCH "$path" -H "Content-Type: application/json" "$@"
}

api_post() {
  local path="$1"
  shift
  api_request POST "$path" -H "Content-Type: application/json" "$@"
}

# --- PKCE OAuth Login ---

generate_pkce() {
  CODE_VERIFIER=$(openssl rand -base64 32 | tr -d '=/+' | head -c 43)
  CODE_CHALLENGE=$(printf '%s' "$CODE_VERIFIER" | openssl dgst -sha256 -binary | openssl base64 -A | tr '+/' '-_' | tr -d '=')
}

cmd_login() {
  generate_pkce

  local state
  state=$(openssl rand -hex 16)
  local port=19283
  local redirect_uri="http://127.0.0.1:${port}"

  local encoded_name
  encoded_name=$(urlencode "$CLIENT_NAME")
  local auth_url="${BASE_URL}/auth/authorize?response_type=code&code_challenge=${CODE_CHALLENGE}&code_challenge_method=S256&redirect_uri=${redirect_uri}&state=${state}&client_name=${encoded_name}"

  echo "Opening browser to authorize..."
  open "$auth_url"
  echo "Waiting for authorization callback on port ${port}..."

  local callback_data
  callback_data=$(ruby -e '
    require "socket"
    require "uri"

    server = TCPServer.new("127.0.0.1", '"$port"')
    server.setsockopt(Socket::SOL_SOCKET, Socket::SO_REUSEADDR, true)

    ready = IO.select([server], nil, nil, 120)
    unless ready
      $stderr.puts "Timed out waiting for authorization."
      server.close
      exit 1
    end

    client = server.accept
    request_line = client.gets
    server.close

    path = request_line.split(" ")[1]
    params = URI.decode_www_form(URI(path).query || "").to_h

    body = "<html><body><h1>Authorized!</h1><p>You can close this tab and return to your terminal.</p><script>window.close()</script></body></html>"
    client.print "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: #{body.bytesize}\r\nConnection: close\r\n\r\n#{body}"
    client.close

    puts params["code"]
    puts params["state"]
  ') || die "Failed to receive authorization callback."

  local auth_code callback_state
  auth_code=$(echo "$callback_data" | head -1)
  callback_state=$(echo "$callback_data" | tail -1)

  [[ -n "$auth_code" ]] || die "No authorization code received."
  [[ "$callback_state" == "$state" ]] || die "State mismatch — possible CSRF attack."

  echo "Exchanging authorization code for token..."

  local token_response
  token_response=$(curl -sS -X POST "${BASE_URL}/auth/token" \
    -H "Content-Type: application/x-www-form-urlencoded" \
    -d "grant_type=authorization_code&code=${auth_code}&code_verifier=${CODE_VERIFIER}&redirect_uri=${redirect_uri}&client_name=${encoded_name}") || die "Token exchange failed."

  local access_token
  access_token=$(echo "$token_response" | ruby -rjson -rtime -e '
    data = JSON.parse(STDIN.read)
    if data["error"]
      $stderr.puts "#{data["error"]}: #{data["error_description"]}"
      exit 1
    end
    puts data["access_token"]
  ') || die "Failed to parse token response."

  [[ -n "$access_token" ]] || die "No access token received."

  register_token "$access_token"
  echo "Authenticated as $REGISTERED_USER! Token saved to Keychain."
}

# --- Commands ---

# Logs out a user. Defaults to the active/resolved user (or the only one).
cmd_logout() {
  local email="${1:-}"

  if [[ -z "$email" ]]; then
    resolve_user
    email="$USER_EMAIL"
  fi

  # No users tracked — fall back to clearing any legacy single-token entry.
  if [[ -z "$email" ]]; then
    if [[ "$(users_index_count)" -gt 1 ]]; then
      die "Multiple users are logged in. Specify which: squirrelstack logout <email>"
    fi
    keychain_delete_for "$LEGACY_KEYCHAIN_ACCOUNT"
    echo "Token removed from Keychain."
    return
  fi

  keychain_delete_for "$email"
  users_index_remove "$email"
  # Drop a global pin that points at this user so it doesn't dangle.
  [[ "$(read_user_from_file "$HOME/.squirrelstack")" == "$email" ]] && clear_config_key "$HOME/.squirrelstack" user
  echo "Logged out $email."
}

cmd_whoami() {
  load_token
  resolve_account

  if [[ -n "${SQUIRRELSTACK_TOKEN:-}" ]]; then
    echo "User:    (from SQUIRRELSTACK_TOKEN env)"
  elif [[ -n "$USER_EMAIL" ]]; then
    echo "User:    $USER_EMAIL (from $USER_SOURCE)"
  else
    echo "User:    (unknown)"
  fi

  if [[ -n "$ACCOUNT_SLUG" ]]; then
    echo "Account: $ACCOUNT_SLUG (from $ACCOUNT_SOURCE)"
  else
    echo "Account: (server default)"
  fi
}

# Lists logged-in users, marking the active one.
cmd_users_list() {
  resolve_user

  local users
  users=$(users_index_list)
  if [[ -z "$users" ]]; then
    echo "No users logged in. Run: squirrelstack login"
    return
  fi

  printf "%-3s  %s\n" "" "EMAIL"
  while IFS= read -r u; do
    [[ -z "$u" ]] && continue
    local marker=" "
    [[ "$u" == "$USER_EMAIL" ]] && marker="*"
    printf "%-3s  %s\n" "$marker" "$u"
  done <<< "$users"

  echo
  if [[ -n "$USER_EMAIL" ]]; then
    echo "Active: $USER_EMAIL ($USER_SOURCE)"
  else
    echo "Active: (none — multiple users; pick with 'squirrelstack users use <email>')"
  fi
}

cmd_users_use() {
  local email="${1:-}"
  [[ -n "$email" ]] || die "Usage: squirrelstack users use <email> [-g|--global]  or  squirrelstack users use --clear [-g|--global]"

  local global=0
  local clear=0
  [[ "$email" == "--clear" ]] && clear=1

  case "${2:-}" in
    -g|--global) global=1 ;;
    "") ;;
    *) die "Unknown option: ${2}" ;;
  esac

  local target
  if [[ "$global" == "1" ]]; then
    target="$HOME/.squirrelstack"
  else
    target="$PWD/.squirrelstack"
  fi

  if [[ "$clear" == "1" ]]; then
    clear_config_key "$target" user
    echo "Cleared user from $target"
    return
  fi

  if ! users_index_list | grep -qxF "$email"; then
    die "Not logged in as '$email'. Logged in: $(users_index_list | paste -sd ', ' -). Run: squirrelstack login"
  fi

  set_config_key "$target" user "$email"
  echo "Wrote $target (user=$email)"
}

# Fetches /api/v1/me and prints accounts, marking the currently resolved one.
cmd_accounts_list() {
  load_token
  resolve_account

  local response
  response=$(api_request GET "/me")

  echo "$response" | ACCOUNT_SLUG="$ACCOUNT_SLUG" ACCOUNT_SOURCE="$ACCOUNT_SOURCE" ruby -rjson -e '
    data = JSON.parse(STDIN.read)
    current = ENV["ACCOUNT_SLUG"]
    source = ENV["ACCOUNT_SOURCE"]
    accounts = data["accounts"]

    if accounts.empty?
      puts "(no accounts)"
      exit
    end

    printf "%-3s  %-25s  %s\n", "", "SLUG", "NAME"
    accounts.each do |a|
      marker = (a["slug"] == current) ? "*" : " "
      printf "%-3s  %-25s  %s\n", marker, a["slug"], a["name"]
    end

    puts
    if current.empty?
      puts "Current: (none — using server default)"
    else
      puts "Current: #{current} (#{source})"
    end
  '
}

cmd_accounts_use() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "Usage: squirrelstack accounts use <slug> [-g|--global]  or  squirrelstack accounts use --clear [-g|--global]"

  local global=0
  local clear=0

  if [[ "$slug" == "--clear" ]]; then
    clear=1
  fi

  case "${2:-}" in
    -g|--global) global=1 ;;
    "") ;;
    *) die "Unknown option: ${2}" ;;
  esac

  local target
  if [[ "$global" == "1" ]]; then
    target="$HOME/.squirrelstack"
  else
    target="$PWD/.squirrelstack"
  fi

  if [[ "$clear" == "1" ]]; then
    if [[ -f "$target" ]] && [[ -n "$(read_account_from_file "$target")" ]]; then
      clear_config_key "$target" account
      echo "Cleared account from $target"
    else
      echo "No pinned account at $target"
    fi
    return
  fi

  # Validate the slug against the user's accounts before writing.
  load_token
  local response
  response=$(api_request GET "/me")
  local valid
  valid=$(echo "$response" | SLUG="$slug" ruby -rjson -e '
    data = JSON.parse(STDIN.read)
    slugs = data["accounts"].map { |a| a["slug"] }
    puts slugs.include?(ENV["SLUG"]) ? "yes" : "no:#{slugs.join(",")}"
  ')

  if [[ "$valid" != "yes" ]]; then
    local available="${valid#no:}"
    die "Account '$slug' is not one of your accounts. Available: $available"
  fi

  set_config_key "$target" account "$slug"
  echo "Wrote $target (account=$slug)"
}

cmd_accounts_current() {
  load_token
  resolve_account
  if [[ -n "$ACCOUNT_SLUG" ]]; then
    echo "$ACCOUNT_SLUG (from $ACCOUNT_SOURCE)"
  else
    echo "(none — server will use default if you have exactly one account)"
  fi
}

cmd_errors_list() {
  load_token
  resolve_account

  local status="unresolved"
  local severity=""
  local environment=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status)    status="$2"; shift 2 ;;
      --severity)  severity="$2"; shift 2 ;;
      --env)       environment="$2"; shift 2 ;;
      --json)      JSON_OUTPUT=1; shift ;;
      *)           die "Unknown option: $1" ;;
    esac
  done

  local query="status=${status}"
  [[ -n "$severity" ]] && query="${query}&severity=${severity}"
  [[ -n "$environment" ]] && query="${query}&environment=${environment}"

  local response
  response=$(api_get "/errors?${query}")

  if [[ "${JSON_OUTPUT:-}" == "1" ]]; then
    echo "$response" | ruby -rjson -rtime -e 'puts JSON.pretty_generate(JSON.parse(STDIN.read))'
    return
  fi

  local count
  count=$(echo "$response" | ruby -rjson -rtime -e 'puts JSON.parse(STDIN.read)["errors"].length')

  if [[ "$count" == "0" ]]; then
    echo "No ${status} errors found."
    return
  fi

  echo "$response" | ruby -rjson -rtime -e '
    errors = JSON.parse(STDIN.read)["errors"]
    severity_icons = { "critical" => "!!!", "error" => "!! ", "warning" => "!  ", "info" => "   " }
    priority_icons = { "critical" => "P0", "high" => "P1", "medium" => "P2", "low" => "P3" }

    printf "%-8s  %-4s  %-4s  %-8s  %5s  %-15s  %-35s  %-25s  %s\n", "ID", "SEV", "PRI", "ENV", "COUNT", "ASSIGNEE", "TYPE", "MESSAGE", "LAST SEEN"
    printf "%s\n", "-" * 140

    errors.each do |e|
      id = e["id"].to_s
      sev = severity_icons[e["severity"]] || "   "
      pri = priority_icons[e["priority"]] || "--"
      env = (e["environment"] || "")[0..7]
      count = e["occurrences_count"].to_s
