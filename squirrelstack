# --- Main ---

# Pre-scan for --account and --user flags so they can appear anywhere in the args.
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --account)    ACCOUNT_FLAG="${2:-}"; shift 2 ;;
    --account=*)  ACCOUNT_FLAG="${1#--account=}"; shift ;;
    --user)       USER_FLAG="${2:-}"; shift 2 ;;
    --user=*)     USER_FLAG="${1#--user=}"; shift ;;
    *)            args+=("$1"); shift ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

command="${1:-help}"
shift || true

case "$command" in
  login)         cmd_login ;;
  logout)        cmd_logout "$@" ;;
  whoami)        cmd_whoami ;;
  users)
    subcommand="${1:-list}"
    case "$subcommand" in
      use)     shift; cmd_users_use "$@" ;;
      list|"") cmd_users_list ;;
      *)       die "Unknown users subcommand: $subcommand. Try: list, use" ;;
    esac
    ;;
  accounts)
    subcommand="${1:-list}"
    case "$subcommand" in
      use)     shift; cmd_accounts_use "$@" ;;
      current) cmd_accounts_current ;;
      list|"") cmd_accounts_list ;;
      *)       die "Unknown accounts subcommand: $subcommand. Try: list, use, current" ;;
    esac
    ;;
  errors)
    subcommand="${1:-list}"
    case "$subcommand" in
      show)    shift; cmd_errors_show "$@" ;;
      update)  shift; cmd_errors_update "$@" ;;
      comment) shift; cmd_errors_comment "$@" ;;
      members) cmd_errors_members ;;
      *)       cmd_errors_list "$@" ;;
    esac
    ;;
  tickets)
    subcommand="${1:-list}"
    case "$subcommand" in
      show) shift; cmd_tickets_show "$@" ;;
      *)    cmd_tickets_list "$@" ;;
    esac
    ;;
  epics)
    subcommand="${1:-list}"
    case "$subcommand" in
      show)   shift; cmd_epics_show "$@" ;;
      create) shift; cmd_epics_create "$@" ;;
      update) shift; cmd_epics_update "$@" ;;
      *)      cmd_epics_list "$@" ;;
    esac
    ;;
  stories)
    subcommand="${1:-list}"
    case "$subcommand" in
      show)   shift; cmd_stories_show "$@" ;;
      create) shift; cmd_stories_create "$@" ;;
      update) shift; cmd_stories_update "$@" ;;
      *)      cmd_stories_list "$@" ;;
    esac
    ;;
  version|--version|-v) echo "squirrelstack $VERSION" ;;
  help|--help|-h) cmd_help ;;
  *)              die "Unknown command: $command. Run: squirrelstack help" ;;
esac
