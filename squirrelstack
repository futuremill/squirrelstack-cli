# Builds a JSON object from "key type value" triples. type is s (string),
# n (number) or null. Used so titles and descriptions are escaped properly.
json_object() {
  ruby -rjson -e '
    h = {}
    ARGV.each_slice(3) do |k, t, v|
      h[k] = case t
             when "n" then v.include?(".") ? v.to_f : v.to_i
             when "null" then nil
             else v
             end
    end
    puts h.to_json
  ' -- "$@"
}

# Appends a --flag value pair to the triple list, mapping "none" to null for ids.
# Usage: json_fields+=( $(json_triple key type value) ) is awkward with spaces,
# so callers push onto the array directly.
pretty_json() { ruby -rjson -e 'puts JSON.pretty_generate(JSON.parse(STDIN.read))'; }

